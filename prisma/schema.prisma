// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id           String   @id @default(cuid())
  nome         String
  slug         String   @unique
  email        String   @unique
  senhaAdmin   String
  documento    String   @unique
  telefone     String
  corPrincipal String?
  descricao    String?
  criadoEm     DateTime @default(now())

  servicos      Servico[]
  horarios      HorarioFuncionamento[]
  agendamentos  Agendamento[]
  profissionais Profissional[]         // novo

  @@map("empresas")
}

model Servico {
  id      String @id @default(uuid())
  nome    String
  preco   Float
  duracao Int    // em minutos

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  agendamentos Agendamento[]

  // Um serviço pode ser oferecido por vários profissionais
  profissionais ProfissionalServico[]  // novo

  @@map("servicos")
}

// NOVO MODEL
model Profissional {
  id        String  @id @default(uuid())
  nome      String
  telefone  String?
  foto      String? // URL da foto
  estaAtivo Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  agendamentos Agendamento[]
  servicos     ProfissionalServico[]  // serviços que este profissional executa

  @@map("profissionais")
}

// NOVO MODEL — tabela de junção Profissional <-> Servico
model ProfissionalServico {
  profissionalId String
  servicoId      String

  profissional Profissional @relation(fields: [profissionalId], references: [id])
  servico      Servico      @relation(fields: [servicoId],      references: [id])

  @@id([profissionalId, servicoId])
  @@map("profissional_servicos")
}

model HorarioFuncionamento {
  id         String  @id @default(uuid())
  diaSemana  Int     // 0=Dom, 1=Seg … 6=Sab
  abertura   String  // "09:00"
  fechamento String  // "18:00"
  estaAtivo  Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, diaSemana])
  @@map("horarios_funcionamento")
}

model Agendamento {
  id              String   @id @default(uuid())
  clienteNome     String
  clienteEmail    String
  clienteCpf      String
  dataHora        DateTime
  statusPagamento String   @default("PENDENTE")
  statusReserva   String   @default("AGUARDANDO_PAGAMENTO")
  valorTotal      Float
  asaasPaymentId  String?  @unique
  criadoEm        DateTime @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])

  profissionalId String?                // opcional no banco
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  @@map("agendamentos")
}