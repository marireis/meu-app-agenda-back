generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. A EMPRESA (O PROFISSIONAL/CLIENTE SAAS)
model Empresa {
  id           String   @id @default(uuid())
  nome         String
  slug         String   @unique // URL personalizada: meuapp.com/salao-da-maria
  logoUrl      String?  
  descricao    String?  @db.Text
  corPrincipal String   @default("#3B82F6")
  senhaAdmin   String   @default("123456") // Senha de acesso ao painel desta empresa
  criadoEm     DateTime @default(now())

  // RELAÇÕES: Uma empresa tem vários serviços, horários e agendamentos
  servicos     Servico[]
  horarios     HorarioFuncionamento[]
  agendamentos Agendamento[]
}

// 2. SERVIÇOS (O QUE CADA EMPRESA OFERECE)
model Servico {
  id        String   @id @default(uuid())
  nome      String   // Ex: "Corte de Cabelo"
  preco     Float    // Ex: 50.00
  duracao   Int      // Duração em minutos: 30, 60, 90 (Crucial para a agenda)
  
  // RELAÇÃO: Cada serviço pertence a uma única empresa
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  
  // RELAÇÃO: Um serviço pode estar em vários agendamentos
  agendamentos Agendamento[]
}

// 3. HORÁRIOS DE FUNCIONAMENTO (REGRAS DE DISPONIBILIDADE)
model HorarioFuncionamento {
  id         String   @id @default(uuid())
  diaSemana  Int      // 0 (Domingo) a 6 (Sábado)
  abertura   String   // "08:00"
  fechamento String   // "18:00"
  estaAtivo  Boolean  @default(true) // Define se o salão abre nesse dia

  // RELAÇÃO: Cada regra de horário pertence a uma empresa
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])

  // Garante que não existam dois registros para o mesmo dia na mesma empresa
  @@unique([empresaId, diaSemana]) 
}

// 4. AGENDAMENTOS (A TRANSAÇÃO FINAL)
model Agendamento {
  id              String   @id @default(uuid())
  clienteNome     String
  clienteEmail    String
  clienteCpf      String
  dataHora        DateTime // Data e hora exata do início
  statusPagamento String   @default("PENDENTE") // PENDENTE, PAGO, CANCELADO
  statusReserva   String   @default("AGUARDANDO_PAGAMENTO")
  valorTotal      Float
  asaasPaymentId  String?  @unique
  criadoEm        DateTime @default(now())

  // RELAÇÃO: Vinculado à Empresa (Multi-tenancy)
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id])

  // RELAÇÃO: Vinculado ao Serviço (Para saber a duração e preço)
  servicoId       String
  servico         Servico  @relation(fields: [servicoId], references: [id])
}